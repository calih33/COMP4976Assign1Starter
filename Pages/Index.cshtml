@page
@model IndexModel
@{
    ViewData["Title"] = "Profiles";
}

<div class="p-4 mb-4 bg-light rounded-3">
    <h1 class="display-5">Profiles</h1>
    <p class="lead mb-0">Open a profile, then make it yours: describe a look in the box in the corner, or type "theme from my bio".</p>
</div>

<div class="row row-cols-1 row-cols-md-2 g-3">
    @foreach (var profile in Model.MyProfiles)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-body d-flex gap-3">
                    <div class="avatar flex-shrink-0">@(string.Concat((profile.Name ?? "").Split(' ').Select(w => w[0])))</div>
                    <div>
                        <h2 class="h5 card-title mb-0">@profile.Name</h2>
                        <p class="text-muted mb-2">@@@profile.Handle · @profile.Location</p>
                        <p class="mb-0">@profile.Bio</p>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a class="btn btn-sm btn-primary" asp-page="/ProfilePages/Details" asp-route-id="@profile.ProfileId">View profile</a>
                </div>
            </div>
        </div>
    }
</div>
